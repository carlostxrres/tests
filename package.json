    "@vitejs/plugin-react": "^6.1.1",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
