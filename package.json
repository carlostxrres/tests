{
  "name": "tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:push": "sh -c 'set -a; . ./.env; set +a; supabase db push --db-url \"$DIRECT_URL\"'",
