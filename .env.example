# Supabase project settings (dashboard: Project Settings > API)
# Frontend uses these (Vite only exposes vars prefixed with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by `pnpm db:seed` (scripts/seed.ts). Never expose to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (dashboard: Connect > Direct connection, port 5432).
# Used only by `pnpm db:push` and `pnpm db:types`.
DIRECT_URL=
